# start.bat copies this to .env on first run. Edit .env, not this file.
SITE_NAME=StudyVault
PORT=8000

# Keep "true" when you open the site through Cloudflare (HTTPS).
# "false" is needed for plain http://localhost:8000 (start.bat sets this for you).
COOKIE_SECURE=true
SESSION_HOURS=72

# Cloudflare's free plan rejects uploads over 100 MB through the tunnel.
# Bigger videos: upload them on your PC at http://localhost:8000.
MAX_UPLOAD_MB=500

# AI via Hugging Face Inference Providers.
# Token: https://huggingface.co/settings/tokens → Fine-grained → tick "Make calls to Inference Providers".
HF_TOKEN=
# Any chat model with an Inference Provider (see its model page → "Deploy" → "Inference Providers").
# Bigger = better answers, more credits: Qwen/Qwen2.5-72B-Instruct, meta-llama/Llama-3.3-70B-Instruct
CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Changing this needs a reindex (npm run manage reindex, or Settings → Rebuild index).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional automatic transcripts for video/audio, made by a Hugging Face speech-to-text model.
# Uses your Inference credits; very long recordings may be rejected.
TRANSCRIBE_MEDIA=false
WHISPER_MODEL=openai/whisper-large-v3

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel (Docker install command)
TUNNEL_TOKEN=
